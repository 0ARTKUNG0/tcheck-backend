PORT=5000
MONGODB_URL=mongodb://localhost:27017/{name}
JWT_SECRET=secret
NODE_ENV=development
BASE_URL=http://localhost:3000

# AI Provider Configuration
AI_PROVIDER=typhoon # Options: typhoon, lmstudio, openai
AI_MAX_TEXT_LENGTH=5000 # Maximum text length for grammar check
AI_TIMEOUT_MS=12000 # AI request timeout in milliseconds

# Token Limits by User Role (characters allowed per request)
TOKEN_LIMIT_GUEST=1000 # Guest users (not logged in)
TOKEN_LIMIT_USER_FREE=4000 # Free tier users
TOKEN_LIMIT_USER_PRO=10000 # Pro tier users
TOKEN_LIMIT_ADMIN=50000 # Admin users

# Typhoon AI Configuration (required if AI_PROVIDER=typhoon)
TYPHOON_API_KEY=your_api_key_here
TYPHOON_BASE_URL=https://api.opentyphoon.ai
TYPHOON_MODEL=typhoon-v1.5-instruct # Model to use (optional, defaults to typhoon-v1.5-instruct)

# LM Studio Configuration (required if AI_PROVIDER=lmstudio)
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=local-model # Model name for LM Studio (optional, uses loaded model)

# OpenAI-Compatible Provider Configuration (required if AI_PROVIDER=openai)
# Works with any OpenAI-compatible API: OpenAI, Gemini, Groq, Together, Mistral, DeepSeek, Ollama, etc.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_API_KEY=your_api_key_here
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Rate Limiting Configuration
# Per-minute limits by role
AI_RATE_LIMIT_GUEST=5 # Guest users (not logged in) - 5 requests/minute
AI_RATE_LIMIT_FREE=10 # Free tier users - 10 requests/minute
AI_RATE_LIMIT_PRO=30 # Pro tier users - 30 requests/minute
AI_RATE_LIMIT_ADMIN=100 # Admin users - 100 requests/minute
AI_RATE_WINDOW_MS=60000 # Rate limit window in milliseconds (default: 1 minute)

# Note: Per-second limits are enforced automatically:
# Guest: 1/sec, Free: 2/sec, Pro: 4/sec, Admin: 5/sec (Typhoon's max)

# Omise Configuration
OMISE_URL=https://api.omise.co/transfers
OMISE_PUBLIC_KEY=pkey_test_66znrg3tfasdyeah7cs
OMISE_SECRET_KEY=skey_test_66znrg4ehnlfrlfnc9d
RECIPIENT_ID=recp_test_66znrg442fngxw5the6
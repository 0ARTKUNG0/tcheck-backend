{
  "info": {
    "_postman_id": "tcheck-full-api-v1",
    "name": "tcheck Full API - Payment + Subscription",
    "description": "Complete Postman collection for testing tcheck backend: Auth, User, PromptPay, Card Payment, Webhook, and Subscription.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"testuser\",\n  \"user_email\": \"test@example.com\",\n  \"user_password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/user/signup", "host": ["{{base_url}}"], "path": ["api", "user", "signup"] },
            "description": "Register a new user. Use this first if test@example.com doesn't exist."
          },
          "response": []
        },
        {
          "name": "Signin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_email\": \"test@example.com\",\n  \"user_password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/user/signin", "host": ["{{base_url}}"], "path": ["api", "user", "signin"] },
            "description": "Login and get JWT token (sent in cookie). For Postman, use the token variable."
          },
          "response": []
        },
        {
          "name": "Signout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/user/signout", "host": ["{{base_url}}"], "path": ["api", "user", "signout"] },
            "description": "Logout user"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. User",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/user/profile", "host": ["{{base_url}}"], "path": ["api", "user", "profile"] },
            "description": "Get current user info including role"
          },
          "response": []
        },
        {
          "name": "Check Token (AI)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/user/check-token", "host": ["{{base_url}}"], "path": ["api", "user", "check-token"] },
            "description": "Check remaining AI tokens"
          },
          "response": []
        },
        {
          "name": "Update Username",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"newname\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/user/update-username", "host": ["{{base_url}}"], "path": ["api", "user", "update-username"] },
            "description": "Update user name"
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. PromptPay",
      "item": [
        {
          "name": "Create PromptPay QR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500,\n  \"description\": \"Test PromptPay\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/payment/promptpay/create", "host": ["{{base_url}}"], "path": ["api", "payment", "promptpay", "create"] },
            "description": "Create PromptPay QR. Save omise_charge_id to {{charge_id}} variable."
          },
          "response": []
        },
        {
          "name": "Get PromptPay Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/payment/promptpay/{{payment_id}}", "host": ["{{base_url}}"], "path": ["api", "payment", "promptpay", "{{payment_id}}"] },
            "description": "Check PromptPay payment status"
          },
          "response": []
        },
        {
          "name": "PromptPay History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/payment/promptpay/history", "host": ["{{base_url}}"], "path": ["api", "payment", "promptpay", "history"] },
            "description": "Get all PromptPay payments"
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Card",
      "item": [
        {
          "name": "Create Card Token (Omise Vault)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "pkey_test_67fprtb0j7k3dfn4172", "type": "string" },
                { "key": "password", "value": "", "type": "string" }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "card[name]", "value": "Test User" },
                { "key": "card[number]", "value": "4242424242424242" },
                { "key": "card[expiration_month]", "value": "12" },
                { "key": "card[expiration_year]", "value": "2027" },
                { "key": "card[security_code]", "value": "123" }
              ]
            },
            "url": { "raw": "https://vault.omise.co/tokens", "protocol": "https", "host": ["vault", "omise", "co"], "path": ["tokens"] },
            "description": "Create a card token. Auth: Basic Auth, username=public key, password=empty. Copy token id to {{card_token}}."
          },
          "response": []
        },
        {
          "name": "Create Card Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 199,\n  \"description\": \"Test Card Payment\",\n  \"card_token\": \"{{card_token}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/payment/card/create", "host": ["{{base_url}}"], "path": ["api", "payment", "card", "create"] },
            "description": "Charge a card. Must create new token first (single-use). Save omise_charge_id to {{charge_id}}."
          },
          "response": []
        },
        {
          "name": "Card Payment History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/payment/card/history", "host": ["{{base_url}}"], "path": ["api", "payment", "card", "history"] },
            "description": "Get all card payments"
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Subscription",
      "item": [
        {
          "name": "Get Subscription Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/subscription/status", "host": ["{{base_url}}"], "path": ["api", "subscription", "status"] },
            "description": "Check subscription status: role, expiry, days remaining"
          },
          "response": []
        },
        {
          "name": "Grant Pro (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"days\": 30\n}"
            },
            "url": { "raw": "{{base_url}}/api/subscription/grant-pro", "host": ["{{base_url}}"], "path": ["api", "subscription", "grant-pro"] },
            "description": "Admin only: manually grant Pro access to a user. Requires admin JWT token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Webhook",
      "item": [
        {
          "name": "Omise Webhook (Simulate)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"charge.complete\",\n  \"data\": {\n    \"id\": \"{{charge_id}}\",\n    \"status\": \"successful\",\n    \"amount\": 19900,\n    \"currency\": \"THB\",\n    \"paid\": true,\n    \"paid_at\": \"2026-04-25T12:00:00Z\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/api/webhook/omise", "host": ["{{base_url}}"], "path": ["api", "webhook", "omise"] },
            "description": "Simulate Omise webhook. No auth. This triggers: payment status -> paid, user role -> user-pro. Set {{charge_id}} from PromptPay/Card create response."
          },
          "response": []
        },
        {
          "name": "Webhook Test (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/webhook/test", "host": ["{{base_url}}"], "path": ["api", "webhook", "test"] },
            "description": "Test if webhook endpoint is reachable"
          },
          "response": []
        }
      ]
    }
  ],
